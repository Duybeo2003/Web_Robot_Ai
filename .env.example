# Database and cache
ROBOEQ_IMAGE=nguyenduy203/web-robot-ai:replace-with-release-sha
DB_ROOT_PASSWORD=replace-with-a-long-random-password
DB_NAME=web_robot_ai
DB_USER=roboeq_app
DB_PASSWORD=replace-with-a-url-safe-random-password
DATABASE_URL=mysql://roboeq_app:replace-with-a-url-safe-random-password@localhost:3306/web_robot_ai
REDIS_URL=redis://localhost:6379

# Authentication
NEXTAUTH_SECRET=replace-with-at-least-32-random-bytes
NEXTAUTH_URL=https://example.com
AUTH_SECRET=replace-with-the-same-secret-when-running-without-compose
AUTH_URL=https://example.com
AUTH_TRUST_HOST=true
NEXT_PUBLIC_APP_URL=https://example.com

# Optional public social/storefront links (HTTPS)
SOCIAL_FACEBOOK_URL=https://www.facebook.com/profile.php?id=YOUR_PAGE_ID
SOCIAL_SHOPEE_URL=https://shopee.vn/your-shop
SOCIAL_TIKTOK_URL=https://www.tiktok.com/@your-account
SOCIAL_ZALO_URL=https://zalo.me/YOUR_PHONE_NUMBER

# Public legal identity and customer support
LEGAL_COMPANY_NAME=CÔNG TY TNHH CÔNG NGHỆ GIÁO DỤC ROBOEQ
LEGAL_TAX_CODE=replace-with-tax-code
LEGAL_REGISTRATION_NUMBER=
LEGAL_ADDRESS=Thôn Yên Việt, Xã Đông Cứu, Tỉnh Bắc Ninh
SUPPORT_PHONE=replace-with-support-phone
SUPPORT_EMAIL=replace-with-support-email

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Email
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=
EMAIL_FROM="RoboEQ <no-reply@example.com>"
ADMIN_EMAIL=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# VNPay
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://pay.vnpay.vn/vpcpay.html
VNP_RETURN_URL=https://example.com/api/vnpay/vnpay_return
# Configure this URL as the merchant IPN URL: https://example.com/api/vnpay/ipn

# Public bank-transfer destination shown on checkout confirmation
# BANK_ID is the VietQR bank short code, e.g. vcb (Vietcombank), tcb (Techcombank), acb (ACB)
BANK_ID=vcb
BANK_ACCOUNT_NO=replace-with-account-number
BANK_ACCOUNT_NAME=replace-with-account-holder-name

# Scheduled jobs and third-party services
CRON_SECRET=replace-with-at-least-32-random-bytes
LOGISTICS_API_URL=
LOGISTICS_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Analytics — add your GA4 Measurement ID (starts with G-)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Error tracking — install @sentry/nextjs then add your DSN
# npm install @sentry/nextjs
SENTRY_DSN=

# Uptime monitoring — point your monitor at GET /api/health
# Returns 200 {"status":"ok"} when DB + Redis are reachable, 503 when degraded

# E2E testing only (local dev, never set in production) — an admin account
# seeded in your dev DB. Without these, tests/e2e/admin-crud.spec.ts skips.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
