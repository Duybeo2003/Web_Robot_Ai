generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  EDITOR
  STORE_MANAGER
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
}

enum SupplyType {
  IN_HOUSE
  AFFILIATE_SELL
  PRE_ORDER
  AFFILIATE_HOST
}

enum ProductType {
  ROBOT_STEM
  KIT_ARDUINO
  DO_CHOI_LOGIC
}

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  VOID
}

enum AgeRange {
  AGE_3_5
  AGE_6_8
  AGE_9_12
  AGE_12_PLUS
}

enum PrimarySkill {
  LOGIC
  LANGUAGE
  MOTOR_SKILLS
  EQ
}

enum RmaStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum CommissionStatus {
  PENDING
  PAID
  CANCELLED
}

// ------------------------------------------------------
// 1. NextAuth v5 Models (Passwordless + OAuth)
// ------------------------------------------------------
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  emailVerified DateTime?
  image         String?
  phoneNumber   String?   @unique
  role          Role      @default(USER)
  points        Int       @default(0)
  
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  warranties    Warranty[]
  returnRequests ReturnRequest[]
  cart          Cart?
  reviews       Review[]
  wishlists     Wishlist[]
  inventoryTransactions InventoryTransaction[]
  articles      Article[]
  commissions   Commission[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? // Soft Delete

  @@index([createdAt])
}

model OtpCode {
  id          String   @id @default(cuid())
  phoneNumber String
  code        String
  expiresAt   DateTime

  createdAt   DateTime @default(now())

  @@index([phoneNumber])
  @@index([createdAt])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?   @db.Text
  access_token       String?   @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?   @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ------------------------------------------------------
// 2. E-commerce Models
// ------------------------------------------------------
model Category {
  id          String    @id @default(cuid())
  name        String
  description String?
  products    Product[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([createdAt])
}

model Product {
  id             String      @id @default(cuid())
  title          String
  slug           String      @unique
  description    String      
  price          Decimal     @db.Decimal(10, 2)
  type           ProductType @default(ROBOT_STEM)
  supplyType     SupplyType  @default(IN_HOUSE)
  sku            String?     @unique
  inventoryCount Int         @default(0)
  imageUrl       String?
  
  // Promotional Fields
  originalPrice    Decimal?  @db.Decimal(10, 2)
  flashSaleActive  Boolean   @default(false)
  flashSaleEndDate DateTime?
  flashSaleStock   Int?
  
  // Educational Metadata
  ageRange         AgeRange?
  primarySkill     PrimarySkill?
  educationalGoal  String?      @db.Text
  
  // Affiliate & Pre-order
  externalAffiliateLink String? // For AFFILIATE_SELL
  commissionRate   Float?       @default(10) // For AFFILIATE_HOST
  depositPercent   Int?         @default(70) // For PRE_ORDER
  estimatedArrivalDate DateTime? // For PRE_ORDER
  
  // Combo Selling Strategy
  isCombo          Boolean      @default(false)
  comboItems       ComboItem[]  @relation("ComboParent")
  partOfCombos     ComboItem[]  @relation("ComboChild")
  
  categoryId     String?
  category       Category?   @relation(fields: [categoryId], references: [id])
  
  variants       ProductVariant[]
  orderItems     OrderItem[]
  cartItems      CartItem[]
  warranties     Warranty[]
  reviews        Review[]
  wishlists      Wishlist[]
  inventoryTransactions InventoryTransaction[]

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?   // Soft Delete

  @@index([categoryId])
  @@index([slug])
  @@index([createdAt])
  @@index([type, price])
  @@index([price])
}

model ProductVariant {
  id             String      @id @default(cuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  // JSON field for dynamic attributes like {"Màu sắc": "Đỏ", "Size": "L"}
  attributes     Json
  
  price          Decimal     @db.Decimal(10, 2)
  originalPrice  Decimal?    @db.Decimal(10, 2)
  inventoryCount Int         @default(0)
  sku            String?
  imageUrl       String?
  
  cartItems      CartItem[]
  orderItems     OrderItem[]
  
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  
  @@index([productId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
  @@index([createdAt])
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
  @@index([productId])
  @@index([variantId])
}

model Order {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  totalAmount     Decimal       @db.Decimal(10, 2)
  depositAmount   Decimal?      @db.Decimal(10, 2)
  
  // Logistics & Payment
  shippingAddress String?       
  receiverPhone   String?
  paymentMethod   PaymentMethod @default(COD)
  paymentStatus   PaymentStatus @default(UNPAID)
  
  // State Machine for Kanban / Order processing
  pointsEarned   Int     @default(0) // Số điểm kiếm được từ đơn này
  pointsUsed     Int     @default(0) // Số điểm đã sử dụng để giảm giá
  discountAmount Decimal @default(0) // Tiền giảm do coupon + points
  status          OrderStatus   @default(PENDING)
  
  items           OrderItem[]
  returnRequests  ReturnRequest[]
  commissions     Commission[]
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?     // Soft Delete

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
  quantity        Int     @default(1)
  priceAtPurchase Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model ComboItem {
  id            String  @id @default(cuid())
  comboId       String
  combo         Product @relation("ComboParent", fields: [comboId], references: [id], onDelete: Cascade)
  productId     String
  product       Product @relation("ComboChild", fields: [productId], references: [id], onDelete: Cascade)
  quantity      Int     @default(1)

  @@index([comboId])
  @@index([productId])
}

// ------------------------------------------------------
// 3. Post-Sale & Support Models
// ------------------------------------------------------
model Warranty {
  id           String         @id @default(cuid())
  serialNumber String         @unique
  status       WarrantyStatus @default(ACTIVE)
  startDate    DateTime       @default(now())
  endDate      DateTime
  
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  productId    String
  product      Product        @relation(fields: [productId], references: [id])

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([userId])
  @@index([productId])
  @@index([createdAt])
}

model ReturnRequest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id])
  
  reason      String    
  imageUrl    String?   // Proof of defect
  status      RmaStatus @default(PENDING)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Commission {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id])
  affiliateUserId String
  affiliateUser   User     @relation(fields: [affiliateUserId], references: [id])
  amount          Decimal  @db.Decimal(10, 2)
  status          CommissionStatus @default(PENDING)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orderId])
  @@index([affiliateUserId])
  @@index([status])
}

// ------------------------------------------------------
// 4. Marketing & Social Models
// ------------------------------------------------------
model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  discountPercent Int?     // Either percent
  discountValue   Decimal? // Or exact value
  minOrderValue   Decimal? // Giá trị đơn hàng tối thiểu để áp dụng
  isFreeship      Boolean  @default(false)
  usageLimit      Int?
  usageCount      Int      @default(0)
  isActive        Boolean  @default(true)
  expiresAt       DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Review {
  id          String   @id @default(cuid())
  rating      Int      // 1-5
  comment     String   
  
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([productId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  model       String
  recordId    String?
  before      Json?
  after       Json?
  timestamp   DateTime @default(now())

  @@index([userId])
  @@index([model])
  @@index([action])
  @@index([timestamp])
}

// ------------------------------------------------------
// 5. Inventory Management Models
// ------------------------------------------------------
enum InventoryTransactionType {
  IN
  OUT
}

model InventoryTransaction {
  id          String                   @id @default(cuid())
  productId   String
  product     Product                  @relation(fields: [productId], references: [id])
  type        InventoryTransactionType
  quantity    Int
  costPrice   Decimal?                 @db.Decimal(10, 2)
  reference   String?                  // E.g., PO number or Order ID
  note        String?                  
  userId      String?
  user        User?                    @relation(fields: [userId], references: [id])
  createdAt   DateTime                 @default(now())

  @@index([productId])
  @@index([type])
  @@index([createdAt])
}

// ------------------------------------------------------
// 6. CMS Models
// ------------------------------------------------------
model Article {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String   @db.LongText
  thumbnail   String?
  published   Boolean  @default(false)
  tags        String?  // Comma-separated tags
  
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId])
  @@index([slug])
  @@index([published])
}

